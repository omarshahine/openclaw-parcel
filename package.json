{
  "name": "openclaw-parcel",
  "version": "2.1.0",
  "description": "OpenClaw plugin for Parcel package delivery tracking",
  "type": "module",
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.6.5"
    },
    "build": {
      "openclawVersion": "2026.6.5",
      "pluginSdkVersion": "2026.6.5"
    }
  },
  "files": [
    "dist/",
    "marketplace.json",
    "openclaw.plugin.json",
    "skills/",
    "src/",
    "vendor/",
    "scripts/rebuild-security-npm.py",
    "scripts/patch-openclaw-minimatch.mjs"
  ],
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "parcel",
    "package-tracking",
    "delivery",
    "shipping"
  ],
  "author": {
    "name": "Omar Shahine",
    "email": "omar@shahine.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/omarshahine/openclaw-parcel.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.5"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "openclaw": "^2026.8.1",
    "typescript": "^7.0.2",
    "npm": "file:vendor/npm-12.2.1-security.20261031.tgz"
  },
  "scripts": {
    "plugin:check": "npx --yes @openclaw/plugin-inspector inspect --no-openclaw",
    "plugin:ci": "npx --yes @openclaw/plugin-inspector ci --no-openclaw --runtime --mock-sdk --allow-execute",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs scripts/test-security-npm.mjs",
    "check": "npm run test && npm run plugin:ci && ./scripts/check-versions.sh",
    "prepack": "npm run build",
    "postinstall": "node scripts/patch-openclaw-minimatch.mjs",
    "test:security": "node --test scripts/test-security-npm.mjs"
  },
  "main": "./dist/index.js",
  "overrides": {
    "openclaw": {
      "npm": "$npm",
      "zod": "4.6.7",
      "undici": "8.12.3"
    },
    "minimatch": "11.0.3"
  }
}
